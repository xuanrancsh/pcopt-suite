<ui:FluentWindow x:Class="PcOpt.Products.GameModePilot.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:PcOpt.UI.Controls;assembly=PcOpt.UI"
                 xmlns:views="clr-namespace:PcOpt.Products.GameModePilot.Views"
                 Title="GameMode Pilot"
                 Width="1040" Height="720"
                 MinWidth="840" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TabControl Grid.Row="1" TabStripPlacement="Left" Background="Transparent" BorderThickness="0">
      <TabItem Header="主界面">
        <views:MainView x:Name="MainViewControl" />
      </TabItem>
      <TabItem Header="游戏">
        <views:GamesView x:Name="GamesViewControl" />
      </TabItem>
      <TabItem Header="设置">
        <views:SettingsView x:Name="SettingsViewControl" />
      </TabItem>
    </TabControl>

    <controls:ToastHost x:Name="Toasts" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="100"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" />
  </Grid>
</ui:FluentWindow>
