<ui:FluentWindow x:Class="PcOpt.Products.GameModePilot.Views.WizardWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:PcOpt.UI.Controls;assembly=PcOpt.UI"
                 Title="GameMode Pilot · 首次使用"
                 Width="760" Height="560"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
  <!-- 根布局：TitleBar 独占顶栏（自带最小化 / 关闭 caption 按钮；NoResize 故不显示最大化，T43 修复）；
       内容 Grid 保持原有 28/44/24 边距语义（44px 顶部预留即由 TitleBar 占据） -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="GameMode Pilot · 首次使用" ShowMaximize="False" />

    <Grid Grid.Row="1" Margin="28,0,28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="欢迎使用 GameMode Pilot" FontWeight="SemiBold"
               FontSize="{DynamicResource PcOpt.Font.Size.Headline}" />

    <StackPanel Grid.Row="1" Margin="0,20,0,0">
      <controls:ProgressSteps Steps="{Binding Steps}"
                              CurrentIndex="{Binding CurrentStep}"
                              StatusText="{Binding CurrentStepTitle}" />

      <TextBlock Margin="0,20,0,0" TextWrapping="Wrap"
                 Foreground="{DynamicResource PcOpt.Brush.TextPrimary}"
                 Text="我们只会在你启动游戏时临时调整几项系统设置（电源计划、计时器精度、进程优先级），游戏一退出就全部自动还原，日常使用零残留。所有改动都会先记录还原日志，崩溃或断电后重启也会自动恢复。" />

      <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                 Foreground="{DynamicResource PcOpt.Brush.TextSecondary}"
                 Text="{Binding ScanStatus}" />

      <CheckBox Content="开机时自动启动（默认关闭，可随时在设置中更改）"
                IsChecked="{Binding AutoStartEnabled}" Margin="0,20,0,0" />

      <Button Content="扫描我的游戏" Command="{Binding ScanCommand}"
              HorizontalAlignment="Left" Padding="16,6" Margin="0,12,0,0" />
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="跳过" Command="{Binding SkipCommand}" Margin="0,0,8,0" Padding="18,6" />
      <Button Content="上一步" Command="{Binding BackCommand}" Margin="0,0,8,0" Padding="18,6" />
      <Button Content="下一步" Command="{Binding NextCommand}" Padding="18,6" />
    </StackPanel>
    </Grid>
  </Grid>
</ui:FluentWindow>
