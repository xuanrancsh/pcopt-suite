<UserControl x:Class="PcOpt.Products.GameModePilot.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PcOpt.UI.Controls;assembly=PcOpt.UI"
             Background="Transparent">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="PcOpt.BoolToVisibility" />
  </UserControl.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="我的游戏" FontWeight="SemiBold"
                 FontSize="{DynamicResource PcOpt.Font.Size.Headline}" />
      <TextBlock Text="{Binding StatusText}" Margin="0,6,0,8" TextWrapping="Wrap"
                 Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" />
      <Button Content="扫描游戏库" Command="{Binding ScanCommand}"
              HorizontalAlignment="Left" Padding="16,6" Margin="0,4,0,12" />
    </StackPanel>

    <Grid Grid.Row="1">
      <ItemsControl ItemsSource="{Binding Games}" VerticalAlignment="Top">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <controls:GameCard Margin="0,0,0,10"
                               GameName="{Binding GameName}"
                               PlatformText="{Binding PlatformText}"
                               AntiCheatText="{Binding AntiCheatText}"
                               ExecutablePath="{Binding ExecutablePath}"
                               IsRunning="{Binding IsRunning}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <controls:EmptyState Visibility="{Binding IsEmpty, Converter={StaticResource PcOpt.BoolToVisibility}}"
                           Title="还没有扫描到游戏"
                           Description="点上面的按钮扫描你已安装的游戏；也可以直接启动游戏，我们会自动识别。"
                           Icon="🕹️" />
    </Grid>
  </Grid>
</UserControl>
