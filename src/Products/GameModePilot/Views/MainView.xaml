<UserControl x:Class="PcOpt.Products.GameModePilot.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PcOpt.UI.Controls;assembly=PcOpt.UI"
             Background="Transparent">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
    <StackPanel>
      <!-- 大状态卡（PRD 5.4：三态一眼可见） -->
      <controls:StatusHeroCard Status="{Binding HeroStatus}"
                               GameName="{Binding HeroGameName}"
                               AppliedCount="{Binding HeroAppliedCount}"
                               RevertedCount="{Binding HeroRevertedCount}" />

      <TextBlock Text="{Binding AntiCheatText}" Margin="4,10,0,0"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource PcOpt.Brush.TextSecondary}"
                 FontSize="{DynamicResource PcOpt.Font.Size.Caption}" />

      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <CheckBox Content="开启自动守护" IsChecked="{Binding GuardianEnabled}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding StatusSummary}" Margin="16,0,0,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" />
      </StackPanel>

      <!-- 调整项网格（PRD 2.6 / A-P1-2） -->
      <TextBlock Text="调整项" FontWeight="SemiBold" Margin="0,24,0,8"
                 FontSize="{DynamicResource PcOpt.Font.Size.Title}" />
      <ItemsControl ItemsSource="{Binding Tweaks}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <controls:TweakCard Width="300" Margin="0,0,12,12"
                                Title="{Binding Title}"
                                Description="{Binding Description}"
                                Risk="{Binding Risk}"
                                IsApplied="{Binding IsEnabled}"
                                ApplyCommand="{Binding ApplyCommand}"
                                RevertCommand="{Binding RevertCommand}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 最近会话（PRD 2.6） -->
      <TextBlock Text="最近会话" FontWeight="SemiBold" Margin="0,12,0,8"
                 FontSize="{DynamicResource PcOpt.Font.Size.Title}" />
      <ItemsControl ItemsSource="{Binding RecentSessions}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
                    BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Detail}" Margin="0,4,0,0"
                           Foreground="{DynamicResource PcOpt.Brush.TextSecondary}"
                           FontSize="{DynamicResource PcOpt.Font.Size.Caption}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Button Content="全部还原" Command="{Binding RevertAllCommand}"
              Margin="0,16,0,8" HorizontalAlignment="Left" Padding="16,6" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
