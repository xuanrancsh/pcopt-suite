<UserControl x:Class="PcOpt.Products.FrameLab.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
    <StackPanel>
      <TextBlock Text="设置" FontSize="{DynamicResource PcOpt.Font.Size.Headline}" FontWeight="SemiBold" />

      <!-- 采集组件状态 -->
      <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
              BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}"
              BorderThickness="1" CornerRadius="{DynamicResource PcOpt.Radius.Card}"
              Padding="16" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="帧时间采集组件" FontWeight="SemiBold" />
          <TextBlock Text="{Binding PresentMonStatus}" TextWrapping="Wrap" Margin="0,4,0,0"
                     Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" />
        </StackPanel>
      </Border>

      <!-- 参数 -->
      <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
              BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}"
              BorderThickness="1" CornerRadius="{DynamicResource PcOpt.Radius.Card}"
              Padding="20" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="默认测试时长（秒）" />
          <TextBox Width="160" HorizontalAlignment="Left" Margin="0,4,0,0"
                   Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Text="默认目标进程名（可留空，采集全屏前台）" Margin="0,14,0,0" />
          <TextBox Width="320" HorizontalAlignment="Left" Margin="0,4,0,0"
                   Text="{Binding LastProcessName, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Text="报告中 1% Low 的默认口径" Margin="0,14,0,0" />
          <ComboBox Width="360" HorizontalAlignment="Left" Margin="0,4,0,0"
                    ItemsSource="{Binding AlgorithmOptions}"
                    SelectedItem="{Binding SelectedAlgorithm}"
                    DisplayMemberPath="Text" />

          <CheckBox Content="在报告中展示温度 / 功耗曲线" Margin="0,14,0,0"
                    IsChecked="{Binding ShowThermal}" />

          <Button Content="保存设置" Command="{Binding SaveCommand}" Margin="0,16,0,0"
                  Padding="20,8" HorizontalAlignment="Left"
                  Background="{DynamicResource PcOpt.Brush.Primary.Solid}"
                  Foreground="{DynamicResource PcOpt.Brush.OnPrimary}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
