<UserControl x:Class="PcOpt.Products.FrameLab.Views.DiagnoseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PcOpt.UI.Controls;assembly=PcOpt.UI"
             Background="Transparent">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
    <StackPanel>
      <TextBlock Text="性能诊断" FontSize="{DynamicResource PcOpt.Font.Size.Headline}" FontWeight="SemiBold" />
      <TextBlock Text="根据你刚才的帧时间数据，找出卡顿的可能原因，并给出可以立刻尝试的建议。"
                 Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />

      <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
              BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}"
              BorderThickness="1" CornerRadius="{DynamicResource PcOpt.Radius.Card}"
              Padding="14" Margin="0,12,0,0">
        <TextBlock Text="{Binding ChannelText}" TextWrapping="Wrap"
                   Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" />
      </Border>

      <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
        <Button Content="开始诊断" Command="{Binding RunDiagnosisCommand}" Padding="20,8"
                Background="{DynamicResource PcOpt.Brush.Primary.Solid}"
                Foreground="{DynamicResource PcOpt.Brush.OnPrimary}" />
        <Button Content="一键优化并复测" Command="{Binding ApplyOptimizationCommand}" Margin="10,0,0,0"
                Padding="20,8"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        <Button Content="还原优化" Command="{Binding RevertOptimizationCommand}" Margin="10,0,0,0"
                Padding="20,8" Background="Transparent" />
      </StackPanel>

      <TextBlock Text="{Binding StatusText}" Margin="0,12,0,0"
                 Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" TextWrapping="Wrap" />

      <!-- 无结果 -->
      <controls:EmptyState Title="暂无诊断结果" Description="{Binding EmptyText}" Icon="🩺"
                           Margin="0,24,0,0"
                           Visibility="{Binding HasDiagnoses, Converter={StaticResource InverseBoolToVis}}" />

      <!-- 诊断列表 -->
      <ItemsControl ItemsSource="{Binding Diagnoses}" Margin="0,16,0,0"
                    Visibility="{Binding HasDiagnoses, Converter={StaticResource BoolToVis}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
                    BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}"
                    BorderThickness="1" CornerRadius="{DynamicResource PcOpt.Radius.Card}"
                    Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="{Binding SeverityText}" FontWeight="SemiBold"
                           Foreground="{DynamicResource PcOpt.Brush.Processing}" />
                <TextBlock Text="{Binding Symptom}" FontSize="{DynamicResource PcOpt.Font.Size.Title}"
                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="{Binding EvidenceText}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" />
                <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{DynamicResource PcOpt.Brush.Primary.Solid}" />
                <TextBlock Text="{Binding ExpectedBenefit}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
