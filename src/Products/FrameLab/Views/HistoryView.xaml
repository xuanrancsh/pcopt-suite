<UserControl x:Class="PcOpt.Products.FrameLab.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PcOpt.UI.Controls;assembly=PcOpt.UI"
             Background="Transparent">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
    <StackPanel>
      <Grid>
        <TextBlock Text="测试历史" FontSize="{DynamicResource PcOpt.Font.Size.Headline}" FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <Button Content="清空历史" Command="{Binding ClearCommand}" HorizontalAlignment="Right"
                Padding="16,6" Background="Transparent" />
      </Grid>
      <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource PcOpt.Brush.TextSecondary}"
                 Margin="0,4,0,0" />

      <controls:EmptyState Title="还没有历史记录"
                           Description="每跑完一次测试，成绩会自动记录在这里，方便你回看每次优化前后的变化。"
                           Icon="🕘" Margin="0,40,0,0"
                           Visibility="{Binding HasEntries, Converter={StaticResource InverseBoolToVis}}" />

      <ItemsControl ItemsSource="{Binding Entries}" Margin="0,16,0,0"
                    Visibility="{Binding HasEntries, Converter={StaticResource BoolToVis}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
                    BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}"
                    BorderThickness="1" CornerRadius="{DynamicResource PcOpt.Radius.Card}"
                    Padding="14" Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="{Binding TimeText}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Label}" Foreground="{DynamicResource PcOpt.Brush.TextSecondary}"
                             FontSize="{DynamicResource PcOpt.Font.Size.Caption}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ProcessText}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding ScoreText}" VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PcOpt.Brush.Primary.Solid}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
