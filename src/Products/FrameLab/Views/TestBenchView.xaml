<UserControl x:Class="PcOpt.Products.FrameLab.Views.TestBenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PcOpt.UI.Controls;assembly=PcOpt.UI"
             Background="Transparent">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
    <StackPanel>
      <TextBlock Text="帧率测试台" FontSize="{DynamicResource PcOpt.Font.Size.Headline}" FontWeight="SemiBold" />
      <TextBlock Text="跑一次测试（默认 60 秒，时长可在「设置」里改），先把现状量出来；优化后再测一次，用数据看有没有变好。"
                 Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />

      <!-- PresentMon 缺失提示（优雅降级，给出获取方式；绝不崩溃） -->
      <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
              BorderBrush="{DynamicResource PcOpt.Brush.Processing}"
              BorderThickness="1"
              CornerRadius="{DynamicResource PcOpt.Radius.Card}"
              Padding="14" Margin="0,12,0,0"
              Visibility="{Binding PresentMonAvailable, Converter={StaticResource InverseBoolToVis}}">
        <StackPanel>
          <TextBlock Text="⚠️ 缺少帧时间采集组件" FontWeight="SemiBold"
                     Foreground="{DynamicResource PcOpt.Brush.Processing}" />
          <TextBlock Text="{Binding AvailabilityMessage}" TextWrapping="Wrap" Margin="0,4,0,0"
                     Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" />
        </StackPanel>
      </Border>

      <!-- 主操作卡：大按钮 + 参数 -->
      <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
              BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}"
              BorderThickness="1"
              CornerRadius="{DynamicResource PcOpt.Radius.Card}"
              Padding="24" Margin="0,12,0,0"
              Effect="{DynamicResource PcOpt.Shadow.Card}">
        <StackPanel>
          <Button Content="{Binding StartButtonText}" Command="{Binding StartCommand}"
                  FontSize="{DynamicResource PcOpt.Font.Size.Title}" FontWeight="SemiBold"
                  Padding="36,18" HorizontalAlignment="Center"
                  Background="{DynamicResource PcOpt.Brush.Primary.Solid}"
                  Foreground="{DynamicResource PcOpt.Brush.OnPrimary}"
                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
          <Button Content="取消采集" Command="{Binding CancelCommand}" Margin="0,10,0,0"
                  Padding="16,6" HorizontalAlignment="Center" Background="Transparent"
                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="测试时长（秒）" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Margin="10,0,0,0" Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            <TextBlock Grid.Column="2" Text="目标进程名（可留空）" VerticalAlignment="Center" Margin="24,0,0,0" />
            <TextBox Grid.Column="3" Margin="10,0,0,0" Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
          </Grid>

          <TextBlock Text="{Binding StatusText}" Margin="0,14,0,0"
                     Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" />
        </StackPanel>
      </Border>

      <!-- 实时迷你图 -->
      <TextBlock Text="实时帧时间" FontSize="{DynamicResource PcOpt.Font.Size.Title}" FontWeight="SemiBold"
                 Margin="0,20,0,8" />
      <controls:FrameChart x:Name="LiveChart" Height="220"
                           FrameTimes="{Binding LiveFrameTimes}"
                           Title="实时帧时间（毫秒）" />

      <!-- 最近成绩 -->
      <TextBlock Text="最近一次成绩" FontSize="{DynamicResource PcOpt.Font.Size.Title}" FontWeight="SemiBold"
                 Margin="0,20,0,8" />
      <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
              BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}"
              BorderThickness="1"
              CornerRadius="{DynamicResource PcOpt.Radius.Card}"
              Padding="16">
        <TextBlock Text="{Binding LastScoreText}" TextWrapping="Wrap"
                   FontSize="{DynamicResource PcOpt.Font.Size.Body}" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
