<UserControl x:Class="PcOpt.Products.GameOptBox.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Text="卸载与清理" FontSize="{DynamicResource PcOpt.Font.Size.Headline}" FontWeight="SemiBold" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
      <StackPanel>
        <!-- 垃圾清理 -->
        <Grid>
          <TextBlock Text="垃圾清理" FontSize="{DynamicResource PcOpt.Font.Size.Title}" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="扫描" Padding="14,6" Background="Transparent" Command="{Binding ScanJunkCommand}" />
            <Button Content="清理选中项" Margin="10,0,0,0" Padding="14,6" Command="{Binding CleanJunkCommand}" />
          </StackPanel>
        </Grid>
        <TextBlock Text="{Binding JunkSummary}" Margin="0,6,0,8"
                   Foreground="{DynamicResource PcOpt.Brush.TextSecondary}"
                   FontSize="{DynamicResource PcOpt.Font.Size.Caption}" />
        <ItemsControl ItemsSource="{Binding JunkCategories}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
                      BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}" BorderThickness="1"
                      CornerRadius="{DynamicResource PcOpt.Radius.Card}" Padding="12" Margin="0,0,0,6">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="{Binding CountText}" VerticalAlignment="Center"
                               Foreground="{DynamicResource PcOpt.Brush.TextSecondary}"
                               FontSize="{DynamicResource PcOpt.Font.Size.Caption}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding SizeText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Appx 卸载 -->
        <Grid Margin="0,20,0,0">
          <TextBlock Text="预装应用（Appx）" FontSize="{DynamicResource PcOpt.Font.Size.Title}" FontWeight="SemiBold" />
          <Button Content="重新扫描" HorizontalAlignment="Right" Padding="14,6" Background="Transparent"
                  Command="{Binding ScanAppxCommand}" />
        </Grid>
        <TextBlock Text="{Binding AppxSummary}" Margin="0,6,0,8"
                   Foreground="{DynamicResource PcOpt.Brush.TextSecondary}"
                   FontSize="{DynamicResource PcOpt.Font.Size.Caption}" />
        <ItemsControl ItemsSource="{Binding Packages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
                      BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}" BorderThickness="1"
                      CornerRadius="{DynamicResource PcOpt.Radius.Card}" Padding="12" Margin="0,0,0,6">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap"
                               Foreground="{DynamicResource PcOpt.Brush.TextSecondary}"
                               FontSize="{DynamicResource PcOpt.Font.Size.Caption}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding RiskText}" VerticalAlignment="Center" Margin="10,0">
                    <TextBlock.Style>
                      <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Foreground" Value="{DynamicResource PcOpt.Brush.TextSecondary}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Risk}" Value="Safe">
                            <Setter Property="Foreground" Value="{DynamicResource PcOpt.Brush.Success}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Risk}" Value="System">
                            <Setter Property="Foreground" Value="{DynamicResource PcOpt.Brush.Danger}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="残留预览" Padding="12,6" Background="Transparent"
                            Command="{Binding PreviewResidualCommand}" />
                    <Button Content="卸载" Margin="8,0,0,0" Padding="12,6"
                            Command="{Binding RemoveCommand}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
