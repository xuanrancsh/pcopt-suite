<UserControl x:Class="PcOpt.Products.GameOptBox.Views.LatencyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PcOpt.UI.Controls;assembly=PcOpt.UI"
             Background="Transparent">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
    <StackPanel>
      <TextBlock Text="延迟优化组" FontSize="{DynamicResource PcOpt.Font.Size.Headline}" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Summary}" Margin="0,8,0,12"
                 Foreground="{DynamicResource PcOpt.Brush.TextSecondary}"
                 FontSize="{DynamicResource PcOpt.Font.Size.Caption}" />

      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <controls:TweakCard Width="440" Margin="0,0,12,12"
                                Title="{Binding Title}"
                                Description="{Binding Description}"
                                Risk="{Binding Risk}"
                                IsApplied="{Binding IsApplied}"
                                ApplyCommand="{Binding ApplyCommand}"
                                RevertCommand="{Binding RevertCommand}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
              BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}" BorderThickness="1"
              CornerRadius="{DynamicResource PcOpt.Radius.Card}" Padding="16" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="💡 使用建议" FontWeight="SemiBold" />
          <TextBlock Text="{Binding UsbNote}" TextWrapping="Wrap" Margin="0,6,0,0"
                     Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" />
          <TextBlock Text="{Binding AudioNote}" TextWrapping="Wrap" Margin="0,6,0,0"
                     Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
