<UserControl x:Class="PcOpt.Products.GameOptBox.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
  <StackPanel Margin="24">
    <TextBlock Text="内存清理" FontSize="{DynamicResource PcOpt.Font.Size.Headline}" FontWeight="SemiBold" />

    <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
            BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}" BorderThickness="1"
            CornerRadius="{DynamicResource PcOpt.Radius.Card}" Padding="20" Margin="0,12,0,0"
            Effect="{DynamicResource PcOpt.Shadow.Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="总内存" Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" />
          <TextBlock Text="{Binding TotalText}" FontSize="{DynamicResource PcOpt.Font.Size.Headline}"
                     FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="已用" Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" />
          <TextBlock Text="{Binding UsedText}" FontSize="{DynamicResource PcOpt.Font.Size.Headline}"
                     FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="可用" Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" />
          <TextBlock Text="{Binding AvailableText}" FontSize="{DynamicResource PcOpt.Font.Size.Headline}"
                     FontWeight="SemiBold" Foreground="{DynamicResource PcOpt.Brush.Success}" />
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock Text="{Binding LastResult}" Margin="0,12,0,0"
               Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" TextWrapping="Wrap" />

    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
      <Button Content="一键清理" Padding="16,6" Command="{Binding CleanAllCommand}" />
      <Button Content="修剪工作集" Margin="10,0,0,0" Padding="16,6" Background="Transparent"
              Command="{Binding TrimWorkingSetsCommand}" />
      <Button Content="清理待机列表" Margin="10,0,0,0" Padding="16,6" Background="Transparent"
              Command="{Binding PurgeStandbyListCommand}" />
      <Button Content="刷新" Margin="10,0,0,0" Padding="16,6" Background="Transparent"
              Command="{Binding RefreshCommand}" />
    </StackPanel>

    <TextBlock Text="待机列表清理需要管理员权限；工作集修剪为尽力而为，不影响正在使用的程序。"
               Margin="0,12,0,0" Foreground="{DynamicResource PcOpt.Brush.TextSecondary}"
               FontSize="{DynamicResource PcOpt.Font.Size.Caption}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
