<UserControl x:Class="PcOpt.Products.GameOptBox.Views.GpuTuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PcOpt.UI.Controls;assembly=PcOpt.UI"
             Background="Transparent">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
    <StackPanel>
      <TextBlock Text="显卡调优（合规版）" FontSize="{DynamicResource PcOpt.Font.Size.Headline}" FontWeight="SemiBold" />
      <TextBlock Text="{Binding VendorText}" Margin="0,8,0,12"
                 Foreground="{DynamicResource PcOpt.Brush.TextSecondary}"
                 FontSize="{DynamicResource PcOpt.Font.Size.Caption}" TextWrapping="Wrap" />

      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <controls:TweakCard Width="440" Margin="0,0,12,12"
                                Title="{Binding Title}"
                                Description="{Binding Description}"
                                Risk="{Binding Risk}"
                                IsApplied="{Binding IsApplied}"
                                ApplyCommand="{Binding ApplyCommand}"
                                RevertCommand="{Binding RevertCommand}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="分厂商 / 通用指引" FontSize="{DynamicResource PcOpt.Font.Size.Title}" FontWeight="SemiBold"
                 Margin="0,12,0,8" />
      <ItemsControl ItemsSource="{Binding Guidance}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
                    BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}" BorderThickness="1"
                    CornerRadius="{DynamicResource PcOpt.Radius.Card}" Padding="16" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
