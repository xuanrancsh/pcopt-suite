<UserControl x:Class="PcOpt.Products.GameOptBox.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
    <StackPanel>
      <TextBlock Text="设置" FontSize="{DynamicResource PcOpt.Font.Size.Headline}" FontWeight="SemiBold" />

      <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
              BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}" BorderThickness="1"
              CornerRadius="{DynamicResource PcOpt.Radius.Card}" Padding="16" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="主题" FontWeight="SemiBold" />
          <TextBlock Text="在窗口右上角切换“跟随系统 / 浅色 / 深色”，切换即时生效、无闪烁。"
                     TextWrapping="Wrap" Margin="0,4,0,0"
                     Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" />
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
              BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}" BorderThickness="1"
              CornerRadius="{DynamicResource PcOpt.Radius.Card}" Padding="16" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="规则包" FontWeight="SemiBold" />
          <TextBlock Text="{Binding RulePackageText}" Margin="0,4,0,0"
                     Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" />
          <TextBlock Text="规则包经 Ed25519 签名；未签名或签名不符的规则一律拒绝执行。"
                     TextWrapping="Wrap" Margin="0,4,0,0"
                     Foreground="{DynamicResource PcOpt.Brush.TextSecondary}"
                     FontSize="{DynamicResource PcOpt.Font.Size.Caption}" />
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
              BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}" BorderThickness="1"
              CornerRadius="{DynamicResource PcOpt.Radius.Card}" Padding="16" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="更新" FontWeight="SemiBold" />
          <CheckBox Content="启动时检查更新（默认关闭，保持离线）" Margin="0,8,0,0"
                    IsChecked="{Binding AutoCheckUpdate}" />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="检查更新" Padding="14,6" Command="{Binding CheckUpdateCommand}" />
            <TextBlock Text="{Binding UpdateResult}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" />
          </StackPanel>
          <TextBlock Text="除更新检查外，本工具不发起任何网络请求（合规红线 #8）。"
                     Margin="0,8,0,0" Foreground="{DynamicResource PcOpt.Brush.TextSecondary}"
                     FontSize="{DynamicResource PcOpt.Font.Size.Caption}" />
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
              BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}" BorderThickness="1"
              CornerRadius="{DynamicResource PcOpt.Radius.Card}" Padding="16" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="配置" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ConfigPath}" Margin="0,4,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource PcOpt.Brush.TextSecondary}"
                     FontSize="{DynamicResource PcOpt.Font.Size.Caption}" />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="导出配置" Padding="14,6" Command="{Binding ExportConfigCommand}" />
            <Button Content="导入配置" Margin="10,0,0,0" Padding="14,6" Background="Transparent"
                    Command="{Binding ImportConfigCommand}" />
            <Button Content="打开数据目录" Margin="10,0,0,0" Padding="14,6" Background="Transparent"
                    Command="{Binding OpenDataFolderCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
              BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}" BorderThickness="1"
              CornerRadius="{DynamicResource PcOpt.Radius.Card}" Padding="16" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="关于" FontWeight="SemiBold" />
          <TextBlock Text="{Binding VersionText}" Margin="0,4,0,0" />
          <TextBlock Text="pcopt-suite · MIT 开源 · 无广告、无遥测、纯本地" Margin="0,4,0,0"
                     Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
