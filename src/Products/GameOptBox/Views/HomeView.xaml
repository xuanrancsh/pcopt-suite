<UserControl x:Class="PcOpt.Products.GameOptBox.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
    <StackPanel>
      <TextBlock Text="电脑健康分" FontSize="{DynamicResource PcOpt.Font.Size.Headline}" FontWeight="SemiBold" />

      <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
              BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}"
              BorderThickness="1"
              CornerRadius="{DynamicResource PcOpt.Radius.Card}"
              Padding="20" Margin="0,12,0,0"
              Effect="{DynamicResource PcOpt.Shadow.Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Overall}" FontSize="{DynamicResource PcOpt.Font.Size.Hero}"
                       FontWeight="Bold" Foreground="{DynamicResource PcOpt.Brush.Primary.Solid}" />
            <TextBlock Text="{Binding Grade}" FontSize="{DynamicResource PcOpt.Font.Size.Title}" />
            <TextBlock Text="满分 100" Foreground="{DynamicResource PcOpt.Brush.TextSecondary}"
                       FontSize="{DynamicResource PcOpt.Font.Size.Caption}" Margin="0,2,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
            <Grid Margin="0,0,0,8">
              <TextBlock Text="开机速度" />
              <TextBlock Text="{Binding StartupScore}" HorizontalAlignment="Right"
                         Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" />
            </Grid>
            <ProgressBar Height="6" Maximum="100" Value="{Binding StartupScore, Mode=OneWay}"
                         Foreground="{DynamicResource PcOpt.Brush.Primary.Solid}"
                         Background="{DynamicResource PcOpt.Brush.CardBorder}" BorderThickness="0" />
            <Grid Margin="0,10,0,8">
              <TextBlock Text="后台服务" />
              <TextBlock Text="{Binding BackgroundScore}" HorizontalAlignment="Right"
                         Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" />
            </Grid>
            <ProgressBar Height="6" Maximum="100" Value="{Binding BackgroundScore, Mode=OneWay}"
                         Foreground="{DynamicResource PcOpt.Brush.Primary.Solid}"
                         Background="{DynamicResource PcOpt.Brush.CardBorder}" BorderThickness="0" />
            <Grid Margin="0,10,0,8">
              <TextBlock Text="游戏就绪" />
              <TextBlock Text="{Binding ReadinessScore}" HorizontalAlignment="Right"
                         Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" />
            </Grid>
            <ProgressBar Height="6" Maximum="100" Value="{Binding ReadinessScore, Mode=OneWay}"
                         Foreground="{DynamicResource PcOpt.Brush.Success}"
                         Background="{DynamicResource PcOpt.Brush.CardBorder}" BorderThickness="0" />
          </StackPanel>
        </Grid>
      </Border>

      <ItemsControl ItemsSource="{Binding Suggestions}" Margin="0,12,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3"
                       Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
        <Button Content="{Binding SuggestionSummary}" Command="{Binding OneClickFixCommand}"
                Padding="16,6" />
        <Button Content="重新体检" Command="{Binding RefreshCommand}" Margin="10,0,0,0" Padding="16,6"
                Background="Transparent" />
      </StackPanel>

      <TextBlock Text="联动" FontSize="{DynamicResource PcOpt.Font.Size.Title}" FontWeight="SemiBold"
                 Margin="0,24,0,8" />
      <StackPanel Orientation="Horizontal">
        <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
                BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}" BorderThickness="1"
                CornerRadius="{DynamicResource PcOpt.Radius.Card}" Padding="16" Width="340" Margin="0,0,12,0"
                Visibility="{Binding GuardianAvailable, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock Text="🛡️ 开启自动守护" FontWeight="SemiBold" />
            <TextBlock Text="让 GameMode Pilot 在游戏启动时自动优化、退出时自动还原。" TextWrapping="Wrap"
                       Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" Margin="0,4,0,8" />
            <Button Content="去开启 →" Command="{Binding OpenGuardianCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
                BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}" BorderThickness="1"
                CornerRadius="{DynamicResource PcOpt.Radius.Card}" Padding="16" Width="340"
                Visibility="{Binding FrameLabAvailable, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock Text="🧪 想验证优化有没有用？" FontWeight="SemiBold" />
            <TextBlock Text="用 FrameLab 先测一测、再优化、前后对比，用数据说话。" TextWrapping="Wrap"
                       Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" Margin="0,4,0,8" />
            <Button Content="去测一测 →" Command="{Binding OpenFrameLabCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
