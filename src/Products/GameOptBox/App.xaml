<Application x:Class="PcOpt.Products.GameOptBox.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
      产品 B 应用资源。
      WPF-UI（Fluent）主题 + 控件字典；默认挂载 PcOpt.UI 深色 Palette，
      PcOptThemeService 启动后按"跟随系统"整体替换，深浅色切换无闪烁（PRD B-P0-11）。
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/PcOpt.UI;component/Themes/Palette.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 布尔 → 可见性（首页联动入口显隐等） -->
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
