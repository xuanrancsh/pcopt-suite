<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>PcOpt.Core</RootNamespace>
    <AssemblyName>PcOpt.Core</AssemblyName>
    <Description>pcopt-suite 共享内核：tweak 引擎 / 还原日志 / 系统 API 封装（零 UI 依赖）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 日志抽象（架构 8.3：Microsoft.Extensions.Logging） -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <!-- 注册表访问（.NET 平台组件，仅 Windows 运行时有实现） -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <!-- Ed25519 规则包签名验证（RFC 8032；.NET BCL 无内置 Ed25519，故引入此库，见 NOTICE） -->
    <PackageReference Include="NSec.Cryptography" Version="26.4.0" />
    <!-- YAML 规则包解析 -->
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <!-- 硬件传感器（MPL-2.0；作 NuGet 依赖调用未修改源码，见 NOTICE 登记；T6 架构 3.3） -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <!-- ETW 内核进程事件追踪（MIT；T8 架构 3.4 GameWatcher；仅 Windows 可用） -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
    <!-- WMI 查询（Win32_Processor / Win32_PhysicalMemory / MSStorageDriver / MSAcpi_ThermalZoneTemperature；仅 Windows）。
         版本与 LibreHardwareMonitorLib 0.9.6 的传递依赖对齐（>= 10.0.2），避免 NU1605 降级 -->
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>

</Project>
