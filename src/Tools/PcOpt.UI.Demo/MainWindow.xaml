<!--
  PcOpt.UI P0 组件走查窗口（PRD 5.6 清单全量展示 + 第 5 章规范）。
  布局：自定义标题栏（主题切换）→ 滚动内容区（各组件分区）→ ToastHost 浮层（右下角）。
-->
<Window x:Class="PcOpt.UI.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PcOpt.UI.Controls;assembly=PcOpt.UI"
        xmlns:services="clr-namespace:PcOpt.UI.Services;assembly=PcOpt.UI"
        Title="PcOpt.UI P0 组件走查"
        Height="860"
        Width="960"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{DynamicResource PcOpt.Brush.WindowBackground}"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 自定义标题栏 ===== -->
        <Border Grid.Row="0"
                Background="{DynamicResource PcOpt.Brush.CardBackground}"
                BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <Grid Margin="16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="🎛️ PcOpt.UI P0 组件走查"
                           FontSize="{DynamicResource PcOpt.Font.Size.Title}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <!-- 主题切换（深浅色 / 跟随系统，切换无闪烁） -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="主题：" Foreground="{DynamicResource PcOpt.Brush.TextSecondary}"
                               VerticalAlignment="Center" />
                    <RadioButton x:Name="ThemeSystem" Content="跟随系统" IsChecked="True"
                                 Margin="8,0,0,0" VerticalAlignment="Center"
                                 Checked="OnThemeChanged"
                                 Foreground="{DynamicResource PcOpt.Brush.TextPrimary}" />
                    <RadioButton x:Name="ThemeLight" Content="浅色"
                                 Margin="8,0,0,0" VerticalAlignment="Center"
                                 Checked="OnThemeChanged"
                                 Foreground="{DynamicResource PcOpt.Brush.TextPrimary}" />
                    <RadioButton x:Name="ThemeDark" Content="深色"
                                 Margin="8,0,0,0" VerticalAlignment="Center"
                                 Checked="OnThemeChanged"
                                 Foreground="{DynamicResource PcOpt.Brush.TextPrimary}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="—" Click="OnMinimizeClick" Width="40" Height="30"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" />
                    <Button Content="✕" Click="OnCloseClick" Width="40" Height="30"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 内容滚动区 ===== -->
        <ScrollViewer Grid.Row="1" Padding="24" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- StatusHeroCard -->
                <TextBlock Text="StatusHeroCard · 全局大状态卡（三态）" FontWeight="SemiBold"
                           FontSize="{DynamicResource PcOpt.Font.Size.Title}" />
                <controls:StatusHeroCard x:Name="HeroCard" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="🛡️ 守护中" Click="OnHeroGuarding" Margin="0,0,8,0" Padding="12,5" />
                    <Button Content="🎮 游戏中" Click="OnHeroPlaying" Margin="0,0,8,0" Padding="12,5" />
                    <Button Content="✅ 已还原" Click="OnHeroRestored" Padding="12,5" />
                </StackPanel>

                <!-- TweakCard -->
                <TextBlock Text="TweakCard · tweak 卡片（风险标签 + 应用/还原）"
                           FontWeight="SemiBold" Margin="0,28,0,0"
                           FontSize="{DynamicResource PcOpt.Font.Size.Title}" />
                <controls:TweakCard x:Name="CardSafe"
                                    Title="让游戏少抢 CPU 的后台服务"
                                    Description="关闭 SysMain 预读取服务，机械硬盘上会感觉更跟手。"
                                    Risk="Safe"
                                    IsApplied="True"
                                    Margin="0,8,0,0"
                                    ApplyClick="OnCardApply" RevertClick="OnCardRevert" />
                <controls:TweakCard x:Name="CardDanger"
                                    Title="关闭 Windows  Defender 实时防护"
                                    Description="可减少游戏时的后台扫描占用，但会降低系统防护能力。"
                                    Risk="Danger"
                                    Margin="0,8,0,0"
                                    ApplyClick="OnCardApply" RevertClick="OnCardRevert" />

                <!-- ConfirmDialog -->
                <TextBlock Text="ConfirmDialog · 危险操作二次确认（PRD 5.5）"
                           FontWeight="SemiBold" Margin="0,28,0,0"
                           FontSize="{DynamicResource PcOpt.Font.Size.Title}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="普通危险确认" Click="OnConfirmNormal" Margin="0,0,8,0" Padding="12,5" />
                    <Button Content="高危确认（需输入“我了解风险”）" Click="OnConfirmHighRisk" Padding="12,5" />
                </StackPanel>

                <!-- ProgressSteps -->
                <TextBlock Text="ProgressSteps · 多步进度（会话应用）"
                           FontWeight="SemiBold" Margin="0,28,0,0"
                           FontSize="{DynamicResource PcOpt.Font.Size.Title}" />
                <controls:ProgressSteps x:Name="Steps" Margin="0,8,0,0" />
                <Button Content="模拟一次会话应用（6 步）" Click="OnRunSteps" Margin="0,8,0,0" Padding="12,5" />

                <!-- GameCard -->
                <TextBlock Text="GameCard · 游戏列表卡"
                           FontWeight="SemiBold" Margin="0,28,0,0"
                           FontSize="{DynamicResource PcOpt.Font.Size.Title}" />
                <controls:GameCard GameName="无畏契约"
                                    PlatformText="riot"
                                    AntiCheatText="Vanguard（内核级）"
                                    ExecutablePath="D:\Riot Games\VALORANT\live\VALORANT.exe"
                                    IsRunning="True"
                                    Margin="0,8,0,0" />
                <controls:GameCard GameName="反恐精英 2"
                                    PlatformText="steam"
                                    AntiCheatText="VAC（用户态）"
                                    ExecutablePath="D:\SteamLibrary\steamapps\common\Counter-Strike Global Offensive\cs2.exe"
                                    Margin="0,8,0,0" />

                <!-- MetricCompareTable -->
                <TextBlock Text="MetricCompareTable · 前后对比表"
                           FontWeight="SemiBold" Margin="0,28,0,0"
                           FontSize="{DynamicResource PcOpt.Font.Size.Title}" />
                <controls:MetricCompareTable x:Name="MetricTable" Margin="0,8,0,0" />

                <!-- FrameChart -->
                <TextBlock Text="FrameChart · 帧时间图（双主题自绘）"
                           FontWeight="SemiBold" Margin="0,28,0,0"
                           FontSize="{DynamicResource PcOpt.Font.Size.Title}" />
                <controls:FrameChart x:Name="Chart"
                                     Title="帧时间（ms）· 优化后"
                                     Height="190"
                                     Margin="0,8,0,0" />

                <!-- EmptyState -->
                <TextBlock Text="EmptyState · 空状态"
                           FontWeight="SemiBold" Margin="0,28,0,0"
                           FontSize="{DynamicResource PcOpt.Font.Size.Title}" />
                <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
                        BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}"
                        BorderThickness="1" CornerRadius="8" Margin="0,8,0,0" Height="180">
                    <controls:EmptyState Title="还没有检测到游戏"
                                         Description="启动一次游戏，或手动添加安装目录，我们就能自动为你守护。"
                                         Icon="🕹️"
                                         ActionText="手动添加游戏" />
                </Border>

                <!-- ToastHost / TrayService -->
                <TextBlock Text="ToastHost · 通知 + 撤销 ｜ TrayService · 托盘"
                           FontWeight="SemiBold" Margin="0,28,0,0"
                           FontSize="{DynamicResource PcOpt.Font.Size.Title}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,24">
                    <Button Content="普通通知" Click="OnToastPlain" Margin="0,0,8,0" Padding="12,5" />
                    <Button Content="带撤销的通知" Click="OnToastUndo" Margin="0,0,8,0" Padding="12,5" />
                    <Button Content="托盘气泡" Click="OnTrayBalloon" Padding="12,5" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== ToastHost 浮层（右下角） ===== -->
        <controls:ToastHost x:Name="Toasts" Grid.Row="0" Grid.RowSpan="2"
                            Panel.ZIndex="100"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="24" />
    </Grid>
</Window>
