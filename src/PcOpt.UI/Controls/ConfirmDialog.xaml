<!--
  ConfirmDialog：危险操作二次确认（PRD 5.5）。
  规范：红色描边对话框 + ⚠️ 图标 + 后果列表（人话，≤3 条）+ "建议先创建还原点"勾选框（默认勾选）
  + 主按钮[我了解，继续]（红色）；高危操作（关 Defender/更新）额外要求输入"我了解风险"才能确认。
-->
<Window x:Class="PcOpt.UI.Controls.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认操作"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
            BorderBrush="{DynamicResource PcOpt.Brush.Danger}"
            BorderThickness="1.5"
            CornerRadius="12"
            Padding="24">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="16" ShadowDepth="4" Direction="270" />
        </Border.Effect>

        <StackPanel>
            <!-- 标题行：⚠️ 图标 + 标题 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="⚠️"
                           FontSize="26"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <TextBlock x:Name="TitleText"
                           Grid.Column="1"
                           Text="确认执行此操作？"
                           FontSize="{DynamicResource PcOpt.Font.Size.Title}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>

            <!-- 操作说明（人话） -->
            <TextBlock x:Name="MessageText"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource PcOpt.Brush.TextPrimary}" />

            <!-- 后果列表（≤3 条，说清后果而非恐吓，PRD 5.3） -->
            <ItemsControl x:Name="ConsequenceList" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="•"
                                       Foreground="{DynamicResource PcOpt.Brush.Danger}"
                                       FontWeight="Bold"
                                       Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 高危操作：输入"我了解风险"四字才能确认（防误触，PRD 5.5） -->
            <StackPanel x:Name="TypedConfirmationPanel" Margin="0,16,0,0" Visibility="Collapsed">
                <TextBlock Text="这是高危操作。请输入「我了解风险」四个字才能继续："
                           Foreground="{DynamicResource PcOpt.Brush.Danger}"
                           TextWrapping="Wrap" />
                <TextBox x:Name="ConfirmationInput"
                         Margin="0,8,0,0"
                         Padding="8,6"
                         VerticalContentAlignment="Center"
                         TextChanged="OnConfirmationInputChanged" />
            </StackPanel>

            <!-- 建议先创建还原点（默认勾选） -->
            <CheckBox x:Name="RestorePointCheckBox"
                      Content="建议先创建还原点（推荐，出问题可一键恢复）"
                      IsChecked="True"
                      Margin="0,16,0,0"
                      Foreground="{DynamicResource PcOpt.Brush.TextPrimary}" />

            <!-- 按钮行：取消 + 我了解，继续（红色主按钮） -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button x:Name="CancelButton"
                        Content="取消"
                        Padding="16,7"
                        Margin="0,0,8,0"
                        Cursor="Hand"
                        Click="OnCancelClick"
                        IsCancel="True">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource PcOpt.Brush.TextPrimary}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource PcOpt.Brush.CardBorder}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="ConfirmButton"
                        Content="我了解，继续"
                        Padding="16,7"
                        Cursor="Hand"
                        Click="OnConfirmClick"
                        IsDefault="True">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="{DynamicResource PcOpt.Brush.Danger}" />
                            <Setter Property="Foreground" Value="{DynamicResource PcOpt.Brush.OnPrimary}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
