<!--
  PcOpt.UI 默认控件样式（WPF 自定义控件约定：Themes/Generic.xaml 自动发现）。
  结构：
  1) MergedDictionaries 默认加载深色 Palette（应用级 ThemeService 会以浅色/深色覆盖，
     查找优先级 Application.Resources > 主题字典，故深浅色切换无闪烁）；
  2) 全部 P0 组件样式（PRD 5.6），颜色/圆角/间距/字号一律 DynamicResource 引用设计 Token。
  RiskBadge 样式保持既有实现不动（已完成组件）。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PcOpt.UI.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/PcOpt.UI;component/Themes/Palette.Dark.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 布尔 → 可见性转换器（ToastHost 撤销按钮显隐） -->
    <BooleanToVisibilityConverter x:Key="PcOpt.BoolToVisibility" />

    <!-- ================= 全局基础样式 ================= -->
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource PcOpt.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource PcOpt.Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource PcOpt.Brush.TextPrimary}" />
    </Style>

    <!-- 按钮：电竞蓝主操作 / 6px 圆角 / 悬浮微反馈（PRD 5.2；显式样式优先，此处仅兜底） -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="{DynamicResource PcOpt.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource PcOpt.Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource PcOpt.Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource PcOpt.Brush.CardBackground.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PcOpt.Brush.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="PART_ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource PcOpt.Radius.Button}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_ButtonBorder" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_ButtonBorder" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_ButtonBorder" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 勾选 / 单选：文字随主题（深色下默认黑字不可读，故显式声明） -->
    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="FontFamily" Value="{DynamicResource PcOpt.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource PcOpt.Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource PcOpt.Brush.TextPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="FontFamily" Value="{DynamicResource PcOpt.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource PcOpt.Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource PcOpt.Brush.TextPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 输入框：深色下可读 -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily" Value="{DynamicResource PcOpt.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource PcOpt.Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource PcOpt.Brush.TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource PcOpt.Brush.TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource PcOpt.Brush.Primary.Solid}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="PART_InputBorder"
                            Background="{DynamicResource PcOpt.Brush.CardBackground.Hover}"
                            BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource PcOpt.Radius.Button}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Margin="{TemplateBinding Padding}"
                                      x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PART_InputBorder" Property="BorderBrush" Value="{DynamicResource PcOpt.Brush.Primary.Solid}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= RiskBadge（既有组件，不动） ================= -->
    <Style TargetType="{x:Type local:RiskBadge}">
        <Setter Property="Height" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RiskBadge}">
                    <Border x:Name="PART_Border"
                            Background="#22C55E"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <TextBlock x:Name="PART_Label"
                                   Text="{Binding RiskText, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="White"
                                   FontSize="12"
                                   Margin="8,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 注意 = 琥珀 #F59E0B -->
                        <Trigger Property="Risk" Value="Notice">
                            <Setter TargetName="PART_Border" Property="Background" Value="#F59E0B" />
                        </Trigger>
                        <!-- 危险 = 红 #EF4444 -->
                        <Trigger Property="Risk" Value="Danger">
                            <Setter TargetName="PART_Border" Property="Background" Value="#EF4444" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= StatusHeroCard（产品 A 大状态卡，PRD 5.4） ================= -->
    <Style TargetType="{x:Type local:StatusHeroCard}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:StatusHeroCard}">
                    <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
                            BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource PcOpt.Radius.Card}"
                            Padding="{DynamicResource PcOpt.Space.6}"
                            Effect="{DynamicResource PcOpt.Shadow.Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- 状态徽章圆（颜色随 Status 三态切换） -->
                            <Border x:Name="PART_StatusDot"
                                    Width="56" Height="56"
                                    CornerRadius="28"
                                    Background="{DynamicResource PcOpt.Brush.Guard}"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="PART_StatusIcon"
                                           Text="🛡️"
                                           FontSize="24"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="PART_StatusText"
                                           Text="{TemplateBinding StatusText}"
                                           FontSize="{DynamicResource PcOpt.Font.Size.Headline}"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="PART_DetailText"
                                           Text="{TemplateBinding DetailText}"
                                           FontSize="{DynamicResource PcOpt.Font.Size.Body}"
                                           Foreground="{DynamicResource PcOpt.Brush.TextSecondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 游戏中 = 绿 -->
                        <Trigger Property="Status" Value="Playing">
                            <Setter TargetName="PART_StatusDot" Property="Background" Value="{DynamicResource PcOpt.Brush.Success}" />
                            <Setter TargetName="PART_StatusIcon" Property="Text" Value="🎮" />
                        </Trigger>
                        <!-- 已还原 = 灰 -->
                        <Trigger Property="Status" Value="Restored">
                            <Setter TargetName="PART_StatusDot" Property="Background" Value="{DynamicResource PcOpt.Brush.Neutral}" />
                            <Setter TargetName="PART_StatusIcon" Property="Text" Value="✅" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= TweakCard（产品 B tweak 卡片，PRD 5.6） ================= -->
    <Style TargetType="{x:Type local:TweakCard}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TweakCard}">
                    <Border x:Name="PART_Card"
                            Background="{DynamicResource PcOpt.Brush.CardBackground}"
                            BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource PcOpt.Radius.Card}"
                            Padding="{DynamicResource PcOpt.Space.4}"
                            Effect="{DynamicResource PcOpt.Shadow.Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <local:RiskBadge Risk="{TemplateBinding Risk}" />
                                    <TextBlock Text="{TemplateBinding Title}"
                                               FontSize="{DynamicResource PcOpt.Font.Size.Title}"
                                               FontWeight="SemiBold"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{TemplateBinding Description}"
                                           Foreground="{DynamicResource PcOpt.Brush.TextSecondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                            <!-- 已应用显示"还原"，未应用显示"应用"（按钮文案 = 动作结果，PRD 5.3） -->
                            <Button x:Name="PART_ActionButton"
                                    Grid.Column="1"
                                    Content="应用"
                                    MinWidth="76"
                                    Padding="12,6"
                                    VerticalAlignment="Center"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}">
                                        <Setter Property="Background" Value="{DynamicResource PcOpt.Brush.Primary}" />
                                        <Setter Property="Foreground" Value="{DynamicResource PcOpt.Brush.OnPrimary}" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="FontSize" Value="{DynamicResource PcOpt.Font.Size.Body}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border x:Name="PART_ButtonBorder"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="{DynamicResource PcOpt.Radius.Button}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="PART_ButtonBorder" Property="Opacity" Value="0.88" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="PART_ButtonBorder" Property="Opacity" Value="0.5" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <!-- 已应用 = 描边样式 + "还原" -->
                                            <DataTrigger Binding="{Binding IsApplied, RelativeSource={RelativeSource AncestorType={x:Type local:TweakCard}}}" Value="True">
                                                <Setter Property="Content" Value="还原" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{DynamicResource PcOpt.Brush.TextPrimary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 生效计数：已应用卡片绿色左边框 + ✓（PRD 5.4） -->
                        <Trigger Property="IsApplied" Value="True">
                            <Setter TargetName="PART_Card" Property="BorderBrush" Value="{DynamicResource PcOpt.Brush.Success}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= ProgressSteps（多步进度，PRD 5.4） ================= -->
    <Style TargetType="{x:Type local:ProgressSteps}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ProgressSteps}">
                    <StackPanel>
                        <ItemsControl x:Name="PART_Steps">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                        <Border Width="22" Height="22" CornerRadius="11"
                                                Background="{DynamicResource PcOpt.Brush.CardBorder}"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="PART_StepGlyph"
                                                       Text="{Binding Glyph}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource PcOpt.Brush.TextSecondary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PcOpt.Brush.Primary.Solid}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PcOpt.Brush.Success}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Text="{Binding Label}"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PcOpt.Brush.TextSecondary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="PART_StatusText"
                                   Text="{TemplateBinding StatusText}"
                                   Foreground="{DynamicResource PcOpt.Brush.TextSecondary}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= ToastHost（右下角通知 + 撤销，PRD 5.4） ================= -->
    <Style TargetType="{x:Type local:ToastHost}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ToastHost}">
                    <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="{DynamicResource PcOpt.Space.4}">
                        <ItemsControl x:Name="PART_Toasts">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
                                            BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource PcOpt.Radius.Card}"
                                            Padding="{DynamicResource PcOpt.Space.3}"
                                            Margin="0,6,0,0"
                                            Effect="{DynamicResource PcOpt.Shadow.Card}"
                                            MinWidth="260">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Message}"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="280"
                                                       VerticalAlignment="Center" />
                                            <!-- 撤销通道（PRD 5.4） -->
                                            <Button Grid.Column="1"
                                                    Content="撤销"
                                                    Command="{Binding UndoCommand}"
                                                    Visibility="{Binding HasUndo, Converter={StaticResource PcOpt.BoolToVisibility}}"
                                                    Background="Transparent"
                                                    Foreground="{DynamicResource PcOpt.Brush.Primary.Solid}"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Margin="8,0,0,0" />
                                            <Button Grid.Column="2"
                                                    Content="✕"
                                                    Command="{Binding CloseCommand}"
                                                    Background="Transparent"
                                                    Foreground="{DynamicResource PcOpt.Brush.TextSecondary}"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Margin="4,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= EmptyState（空状态，PRD 5.4） ================= -->
    <Style TargetType="{x:Type local:EmptyState}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:EmptyState}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{DynamicResource PcOpt.Space.6}">
                        <TextBlock x:Name="PART_Icon"
                                   Text="{TemplateBinding Icon}"
                                   FontSize="48"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{TemplateBinding Title}"
                                   FontSize="{DynamicResource PcOpt.Font.Size.Title}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0" />
                        <TextBlock Text="{TemplateBinding Description}"
                                   Foreground="{DynamicResource PcOpt.Brush.TextSecondary}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   MaxWidth="360"
                                   Margin="0,4,0,0" />
                        <Button x:Name="PART_ActionButton"
                                Content="{TemplateBinding ActionText}"
                                Command="{TemplateBinding ActionCommand}"
                                HorizontalAlignment="Center"
                                Padding="16,6"
                                Margin="0,16,0,0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Background" Value="{DynamicResource PcOpt.Brush.Primary}" />
                                    <Setter Property="Foreground" Value="{DynamicResource PcOpt.Brush.OnPrimary}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="{DynamicResource PcOpt.Radius.Button}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <!-- 未提供行动文案时隐藏按钮（空状态也可以只告知） -->
                                        <DataTrigger Binding="{Binding ActionText, RelativeSource={RelativeSource AncestorType={x:Type local:EmptyState}}}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= GameCard（产品 A 游戏列表卡，PRD 5.6） ================= -->
    <Style TargetType="{x:Type local:GameCard}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:GameCard}">
                    <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
                            BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource PcOpt.Radius.Card}"
                            Padding="{DynamicResource PcOpt.Space.3}"
                            Effect="{DynamicResource PcOpt.Shadow.Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding GameName}"
                                           FontSize="{DynamicResource PcOpt.Font.Size.Title}"
                                           FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <!-- 平台徽标 -->
                                    <Border Background="{DynamicResource PcOpt.Brush.Primary.Solid}"
                                            CornerRadius="4" Padding="6,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{TemplateBinding PlatformText}"
                                                   Foreground="{DynamicResource PcOpt.Brush.OnPrimary}"
                                                   FontSize="{DynamicResource PcOpt.Font.Size.Caption}" />
                                    </Border>
                                    <!-- 反作弊徽标（内核级 = 琥珀提示） -->
                                    <Border x:Name="PART_AntiCheatBadge"
                                            Background="{DynamicResource PcOpt.Brush.Neutral}"
                                            CornerRadius="4" Padding="6,1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{TemplateBinding AntiCheatText}"
                                                   Foreground="{DynamicResource PcOpt.Brush.OnPrimary}"
                                                   FontSize="{DynamicResource PcOpt.Font.Size.Caption}" />
                                    </Border>
                                    <!-- 运行中标记 -->
                                    <TextBlock x:Name="PART_RunningMark"
                                               Text="● 运行中"
                                               Foreground="{DynamicResource PcOpt.Brush.Success}"
                                               FontSize="{DynamicResource PcOpt.Font.Size.Caption}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               Visibility="Collapsed" />
                                </StackPanel>
                                <TextBlock Text="{TemplateBinding ExecutablePath}"
                                           Foreground="{DynamicResource PcOpt.Brush.TextSecondary}"
                                           FontSize="{DynamicResource PcOpt.Font.Size.Caption}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="▶"
                                       FontSize="18"
                                       Foreground="{DynamicResource PcOpt.Brush.TextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsRunning" Value="True">
                            <Setter TargetName="PART_RunningMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_AntiCheatBadge" Property="Background" Value="{DynamicResource PcOpt.Brush.Processing}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= MetricCompareTable（产品 C 前后对比表，PRD 5.6） ================= -->
    <Style TargetType="{x:Type local:MetricCompareTable}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:MetricCompareTable}">
                    <Border Background="{DynamicResource PcOpt.Brush.CardBackground}"
                            BorderBrush="{DynamicResource PcOpt.Brush.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource PcOpt.Radius.Card}"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- 表头 -->
                            <Border Background="{DynamicResource PcOpt.Brush.CardBackground.Hover}"
                                    Padding="{DynamicResource PcOpt.Space.3}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="指标" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="优化前" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="优化后" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="变化" FontWeight="SemiBold" />
                                </Grid>
                            </Border>
                            <ItemsControl x:Name="PART_Rows" Grid.Row="1" Padding="{DynamicResource PcOpt.Space.3}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding BeforeText}"
                                                       Foreground="{DynamicResource PcOpt.Brush.TextSecondary}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding AfterText}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding DeltaText}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Foreground" Value="{DynamicResource PcOpt.Brush.TextSecondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Verdict}" Value="Better">
                                                                <Setter Property="Foreground" Value="{DynamicResource PcOpt.Brush.Success}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Verdict}" Value="Worse">
                                                                <Setter Property="Foreground" Value="{DynamicResource PcOpt.Brush.Danger}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      ================= FrameChart（产品 C 帧时间图，PRD 5.6） =================
      注意：FrameChart 不走模板（无 DefaultStyleKey），由 OnRender 自绘卡片 + 折线 + 均值线，
      避免模板子级遮挡自绘内容；双主题取色在每次绘制时经 TryFindResource 动态解析。
    -->

</ResourceDictionary>
