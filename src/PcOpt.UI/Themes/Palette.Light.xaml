<!--
  PcOpt.UI 浅色主题设计 Token（PRD 5.2）。
  主色：电竞蓝渐变 #3B82F6 → #2563EB；状态色：成功 #22C55E / 守护 #3B82F6 / 处理 #F59E0B / 危险 #EF4444。
  圆角：卡片 8 / 按钮 6 / 对话框 12；间距 4 基数：4/8/12/16/24；卡片内边距 16、卡片间距 12。
  所有键名与 Palette.Dark.xaml 严格一致（ThemeService 整体替换实现深浅色切换，控件一律 DynamicResource 引用）。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ===== 颜色 Token ===== -->
    <Color x:Key="PcOpt.Color.Primary.From">#3B82F6</Color>
    <Color x:Key="PcOpt.Color.Primary.To">#2563EB</Color>
    <Color x:Key="PcOpt.Color.Success">#22C55E</Color>
    <Color x:Key="PcOpt.Color.Guard">#3B82F6</Color>
    <Color x:Key="PcOpt.Color.Processing">#F59E0B</Color>
    <Color x:Key="PcOpt.Color.Danger">#EF4444</Color>
    <Color x:Key="PcOpt.Color.Neutral">#6B7280</Color>

    <Color x:Key="PcOpt.Color.WindowBackground">#F3F5F9</Color>
    <Color x:Key="PcOpt.Color.CardBackground">#FFFFFF</Color>
    <Color x:Key="PcOpt.Color.CardBackground.Hover">#F8FAFC</Color>
    <Color x:Key="PcOpt.Color.CardBorder">#E5E7EB</Color>
    <Color x:Key="PcOpt.Color.TextPrimary">#1F2937</Color>
    <Color x:Key="PcOpt.Color.TextSecondary">#6B7280</Color>
    <Color x:Key="PcOpt.Color.ChartGrid">#E5E7EB</Color>
    <Color x:Key="PcOpt.Color.ChartAverage">#9CA3AF</Color>
    <Color x:Key="PcOpt.Color.Overlay">#66000000</Color>

    <!-- ===== 画笔 Token ===== -->
    <LinearGradientBrush x:Key="PcOpt.Brush.Primary" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource PcOpt.Color.Primary.From}" />
        <GradientStop Offset="1" Color="{StaticResource PcOpt.Color.Primary.To}" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PcOpt.Brush.Primary.Solid" Color="{StaticResource PcOpt.Color.Primary.From}" />
    <SolidColorBrush x:Key="PcOpt.Brush.Success" Color="{StaticResource PcOpt.Color.Success}" />
    <SolidColorBrush x:Key="PcOpt.Brush.Guard" Color="{StaticResource PcOpt.Color.Guard}" />
    <SolidColorBrush x:Key="PcOpt.Brush.Processing" Color="{StaticResource PcOpt.Color.Processing}" />
    <SolidColorBrush x:Key="PcOpt.Brush.Danger" Color="{StaticResource PcOpt.Color.Danger}" />
    <SolidColorBrush x:Key="PcOpt.Brush.Danger.Light" Color="#26EF4444" />
    <SolidColorBrush x:Key="PcOpt.Brush.Neutral" Color="{StaticResource PcOpt.Color.Neutral}" />
    <SolidColorBrush x:Key="PcOpt.Brush.WindowBackground" Color="{StaticResource PcOpt.Color.WindowBackground}" />
    <SolidColorBrush x:Key="PcOpt.Brush.CardBackground" Color="{StaticResource PcOpt.Color.CardBackground}" />
    <SolidColorBrush x:Key="PcOpt.Brush.CardBackground.Hover" Color="{StaticResource PcOpt.Color.CardBackground.Hover}" />
    <SolidColorBrush x:Key="PcOpt.Brush.CardBorder" Color="{StaticResource PcOpt.Color.CardBorder}" />
    <SolidColorBrush x:Key="PcOpt.Brush.TextPrimary" Color="{StaticResource PcOpt.Color.TextPrimary}" />
    <SolidColorBrush x:Key="PcOpt.Brush.TextSecondary" Color="{StaticResource PcOpt.Color.TextSecondary}" />
    <SolidColorBrush x:Key="PcOpt.Brush.ChartGrid" Color="{StaticResource PcOpt.Color.ChartGrid}" />
    <SolidColorBrush x:Key="PcOpt.Brush.ChartAverage" Color="{StaticResource PcOpt.Color.ChartAverage}" />
    <SolidColorBrush x:Key="PcOpt.Brush.Overlay" Color="{StaticResource PcOpt.Color.Overlay}" />
    <SolidColorBrush x:Key="PcOpt.Brush.OnPrimary" Color="#FFFFFF" />

    <!-- ===== 圆角 Token（卡片 8 / 按钮 6 / 对话框 12） ===== -->
    <CornerRadius x:Key="PcOpt.Radius.Card">8</CornerRadius>
    <CornerRadius x:Key="PcOpt.Radius.Button">6</CornerRadius>
    <CornerRadius x:Key="PcOpt.Radius.Dialog">12</CornerRadius>

    <!-- ===== 间距 Token（4 基数） ===== -->
    <Thickness x:Key="PcOpt.Space.1">4</Thickness>
    <Thickness x:Key="PcOpt.Space.2">8</Thickness>
    <Thickness x:Key="PcOpt.Space.3">12</Thickness>
    <Thickness x:Key="PcOpt.Space.4">16</Thickness>
    <Thickness x:Key="PcOpt.Space.6">24</Thickness>

    <!-- ===== 字号 Token（12/14/16/20/28） ===== -->
    <sys:Double x:Key="PcOpt.Font.Size.Caption">12</sys:Double>
    <sys:Double x:Key="PcOpt.Font.Size.Body">14</sys:Double>
    <sys:Double x:Key="PcOpt.Font.Size.Title">16</sys:Double>
    <sys:Double x:Key="PcOpt.Font.Size.Headline">20</sys:Double>
    <sys:Double x:Key="PcOpt.Font.Size.Hero">28</sys:Double>

    <!-- 字体族：中文微软雅黑 UI、西文/数字 Segoe UI Variable（PRD 5.2） -->
    <FontFamily x:Key="PcOpt.Font.Family">Microsoft YaHei UI, Segoe UI Variable, Microsoft YaHei, Segoe UI</FontFamily>

    <!-- ===== 卡片投影（0 2 8 rgba(0,0,0,.08)，不用重投影） ===== -->
    <DropShadowEffect x:Key="PcOpt.Shadow.Card" Color="Black" Opacity="0.08" BlurRadius="8" ShadowDepth="2" Direction="270" />

</ResourceDictionary>
